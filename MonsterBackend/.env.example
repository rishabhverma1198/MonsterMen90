# Supabase Configuration for MonsterBackend
# This file contains example environment variables required for Supabase connection

# Required Supabase credentials
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Development Environment
NODE_ENV=development

# Server Configuration
PORT=3001

# Database Configuration (Optional - for direct DB connections)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=postgres

# Production Values (Replace when deploying)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
# NODE_ENV=production
# PORT=8080