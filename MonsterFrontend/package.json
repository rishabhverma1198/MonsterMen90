{
  "name": "monstermens90",
  "version": "0.0.0",
  "description": "MonsterMen90 - E-commerce platform for clothing and fashion accessories",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist",
    "src",
    "public"
  ],
  "keywords": [
    "ecommerce",
    "clothing",
    "fashion",
    "react",
    "typescript",
    "supabase",
    "tailwindcss"
  ],
  "author": {
    "name": "MonsterMen90 Team",
    "email": "team@monstermens90.com",
    "url": "https://github.com/monstermens90"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/monstermens90/monstermens90#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monstermens90/monstermens90.git"
  },
  "bugs": {
    "url": "https://github.com/monstermens90/monstermens90/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/monstermens90"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:optimized": "NODE_ENV=production tsc -b && vite build",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist",
    "build:check": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Tests not configured yet - run 'npm run test:setup' to configure testing framework\" && exit 1",
    "test:watch": "echo \"Tests not configured yet - run 'npm run test:setup' to configure testing framework\" && exit 1",
    "test:coverage": "echo \"Coverage not configured yet - run 'npm run test:setup' to configure testing framework\" && exit 1",
    "test:setup": "echo \"To set up testing: npm install --save-dev vitest @testing-library/react @testing-library/jest-dom jsdom\"",
    "db:setup": "node setup-database.cjs",
    "db:setup:check": "npm run db:setup",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:studio": "supabase studio",
    "db:status": "supabase status",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:logs": "supabase logs",
    "test:products": "node test-product-management.cjs 2>/dev/null || echo \"test-product-management.cjs not found\"",
    "test:api": "node test-api-integration.ts 2>/dev/null || echo \"test-api-integration.ts not found\"",
    "clean": "rm -rf dist && rm -rf node_modules/.vite",
    "clean:all": "rm -rf dist node_modules .vite",
    "install:clean": "npm ci",
    "install:force": "npm install --force",
    "ci": "npm run type-check && npm run lint:check && npm run build:check",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "lucide-react": "^0.562.0",
    "react-hook-form": "^7.68.0",
    "input-otp": "^1.4.2",
    "recharts": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "react-resizable-panels": "^4.0.8",
    "next-themes": "^0.4.6",
    "vaul": "^1.1.2",
    "react-day-picker": "^9.13.0",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.12",
    "vite": "^7.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.2.5",
    "globals": "^16.5.0",
    "lint-staged": "^15.3.0",
    "husky": "^9.1.7",
    "vite-bundle-analyzer": "^0.8.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  },
  "packageManager": "npm@10.0.0",
  "publishConfig": {
    "access": "restricted"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
